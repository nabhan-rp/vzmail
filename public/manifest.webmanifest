{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "vz-mail-app",
  "name": "VZ Mail — Email Privat @imy.li",
  "short_name": "VZ Mail",
  "description": "Layanan email privat lokal tanpa penyimpanan server permanen (@imy.li) berbasis IndexedDB.",
  "start_url": "/?pwa=mail",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0B0D11",
  "background_color": "#0B0D11",
  "lang": "id",
  "dir": "ltr",
  "categories": ["communication", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/mail-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/mail-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/mail-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/mail.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Tulis Pesan Baru",
      "short_name": "Tulis",
      "description": "Buat dan kirim email privat baru @imy.li",
      "url": "/?action=compose",
      "icons": [
        {
          "src": "/icons/mail-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Kotak Masuk",
      "short_name": "Inbox",
      "description": "Buka kotak pesan masuk",
      "url": "/",
      "icons": [
        {
          "src": "/icons/mail-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "prefer_related_applications": false
}
