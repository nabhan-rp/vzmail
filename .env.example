# VZ Mail (mail.vz.gay) & VZ Links (links.vz.gay / *.imy.li) Environment Configuration

# Local dev server port (optional, defaults to 3000)
PORT="3000"

# Outbound email provider mode: "auto" | "cpanel_relay" | "resend" | "brevo" | "cloudflare"
OUTBOUND_PROVIDER="auto"

# Option A — Hybrid cPanel/WHM Outbound Relay (set in production via `npx wrangler secret put`)
CPANEL_RELAY_URL=""
CPANEL_RELAY_SECRET=""

# Option B — Resend / Brevo Free Transactional API (set in production via `npx wrangler secret put`)
RESEND_API_KEY=""
BREVO_API_KEY=""

# Optional shared secret for /api/mail/* relay protection (in production use: npx wrangler secret put RELAY_AUTH_TOKEN)
RELAY_AUTH_TOKEN=""

# Auth0 Universal SSO Configuration (Custom Domain + Per-Service SPA Client IDs)
VITE_AUTH0_DOMAIN="accounts.vz.gay"
VITE_AUTH0_MAIL_CLIENT_ID="sn75KSPt8iU8RlhI5lCC6MY53yt85jy3"
VITE_AUTH0_LINKS_CLIENT_ID="BVT8uaChXUDLjuCDhtfPYXeSSWn6yuGa"
VITE_ACCOUNT_PORTAL_URL="https://myaccount.vz.gay"
