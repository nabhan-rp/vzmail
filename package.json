{
  "name": "vzmail",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite --port 5173 --strictPort",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview --port 5173 --strictPort",
    "clean": "rm -rf dist .wrangler",
    "lint": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "cf:types": "wrangler types",
    "cf:dev": "npm run build && wrangler dev",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.30.0",
    "@rolldown/binding-linux-x64-gnu": "1.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.5",
    "cloudflare": "7.3.0",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "unenv": "2.0.0-rc.24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.167.0"
  }
}
