{
  "name": "vzmail",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite --port 5173 --strictPort",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview --port 5173 --strictPort",
    "clean": "rm -rf dist .wrangler",
    "lint": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "cf:types": "npx wrangler types",
    "cf:dev": "npm run build && npx wrangler dev",
    "cf:dry-run": "npm run build && npx wrangler deploy --dry-run",
    "cf:deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.30.0",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
